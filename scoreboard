    <!-- SCRIPT FIREBASE & LOGIC -->
    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyAaQLzv_-ILHZpin2z558OrecHtlW8P88c",
            authDomain: "tgripsiambon.firebaseapp.com",
            databaseURL: "https://tgripsiambon-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "tgripsiambon",
            storageBucket: "tgripsiambon.firebasestorage.app",
            messagingSenderId: "835345452490",
            appId: "1:835345452490:web:7ea41998ee906fdde39333"
        };

        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();

        // State Variables
        let globalMatchData = [];
        let globalRekapData = [];
        let activeMatchInfo = { partai: 0, side: '', name: '', cont: '', kategori: '', img: '' };
        let juriStatusData = {};
        
        let globalStDev = 0;
        let globalMedian = 0;
        let penaltyDewan = 0;
        let finalScoreValue = 0;
        let prevPinaltyStates = {};

        let startTime;
        let elapsedTime = 0;
        let timerInterval;

        // Listener Firebase Realtime
        db.ref('matches').on('value', (snapshot) => {
            const data = snapshot.val();
            globalMatchData = data ? Object.keys(data).map(key => ({ partai: key, ...data[key] })) : [];
            updateScoreboardView();
        });

        db.ref('rekap').on('value', (snapshot) => {
            const data = snapshot.val();
            globalRekapData = data ? Object.keys(data).map(key => ({id: key, ...data[key]})) : [];
            updateScoreboardView();
        });

        db.ref('activeMatch').on('value', (snapshot) => {
            const val = snapshot.val();
            if(val) {
                activeMatchInfo = val;
                updateScoreboardView();
            }
        });

        db.ref('juriStatus').on('value', (snapshot) => {
            juriStatusData = snapshot.val() || {};
            updateJuriStatusInScoreboard();
            db.ref('scores').once('value', (snap) => calculateGlobalScores(snap.val()));
        });

        db.ref('scores').on('value', (snapshot) => {
            calculateGlobalScores(snapshot.val());
        });

        db.ref('timer').on('value', (snapshot) => {
            const val = snapshot.val();
            if(val) {
                elapsedTime = val.elapsedTime;
                updateTimerDisplays(elapsedTime);
                
                if(val.isRunning) {
                    if(!timerInterval) {
                        startTime = Date.now() - elapsedTime;
                        timerInterval = setInterval(() => {
                            elapsedTime = Date.now() - startTime;
                            updateTimerDisplays(elapsedTime);
                        }, 10);
                    }
                } else {
                    if(timerInterval) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                    }
                }
            }
        });

        // Function Timer
        function updateTimerDisplays(time) {
            let mins = Math.floor(time / 60000);
            let secs = Math.floor((time % 60000) / 1000);
            let ms = Math.floor((time % 1000) / 10);
            
            let formatted = (mins < 10 ? "0" + mins : mins) + ":" + (secs < 10 ? "0" + secs : secs) + "." + (ms < 10 ? "0" + ms : ms);
            
            document.querySelectorAll('.timer-shared').forEach(el => { el.innerText = formatted; });
        }

        // Function Hitung Nilai
        function calculateGlobalScores(scores) {
            if(!scores) return;
            
            let totalJuriPen = 0;
            let juriValuesForAvg = [];
            let allJuriValues = [];

            for(let i=1; i<=10; i++) {
                let s = scores['juri'+i] || { score: 9.90, penalty: 0, stamina: 0, jurus: 1 };
                const sbjEl = document.getElementById('sbj-'+i);
                
                if(sbjEl) sbjEl.innerText = s.score.toFixed(2);

                if (prevPinaltyStates[i] !== undefined && s.penalty > prevPinaltyStates[i]) {
                    const card = document.getElementById('sb-card-'+i);
                    if(card) {
                        card.classList.remove('flash-pinalty');
                        void card.offsetWidth; 
                        card.classList.add('flash-pinalty');
                        setTimeout(() => { card.classList.remove('flash-pinalty'); }, 1000);
                    }
                }
                prevPinaltyStates[i] = s.penalty;

                totalJuriPen += s.penalty;
                allJuriValues.push(s.score);

                if(juriStatusData['juri'+i] === true) {
                    juriValuesForAvg.push(s.score);
                }
            }

            let averageScore = 0;
            if(juriValuesForAvg.length > 0) {
                averageScore = juriValuesForAvg.reduce((a,b) => a+b, 0) / juriValuesForAvg.length;
            }

            const sorted = [...allJuriValues].sort((a,b) => a-b);
            globalMedian = (sorted[4] + sorted[5]) / 2;
            const meanFull = allJuriValues.reduce((a,b) => a+b, 0) / 10;
            globalStDev = Math.sqrt(allJuriValues.map(x => Math.pow(x - meanFull, 2)).reduce((a,b) => a+b, 0) / 10);
            
            document.getElementById('sb-stdev').innerText = globalStDev.toFixed(11);
            document.getElementById('sb-median').innerText = averageScore.toFixed(3);
            document.getElementById('sb-pen-juri').innerText = totalJuriPen.toFixed(2);

            penaltyDewan = scores.dewanPenalty || 0;
            document.getElementById('sb-pen-dewan').innerText = penaltyDewan.toFixed(2);

            finalScoreValue = averageScore - penaltyDewan; 
            document.getElementById('sb-final-score').innerText = finalScoreValue.toFixed(3);
        }

        // Update indikator Juri
        function updateJuriStatusInScoreboard() {
            for(let i=1; i<=10; i++) {
                const card = document.getElementById('sb-card-'+i);
                if(card) {
                    const isOnline = juriStatusData['juri'+i] === true;
                    if(isOnline) card.classList.remove('offline');
                    else card.classList.add('offline');
                }
            }
        }

        // Logic View Match & View Comparison
        function updateScoreboardView() {
            const info = activeMatchInfo;
            if(!info || !info.partai) return;

            const match = globalMatchData.find(m => m.partai == info.partai);
            const sbSingle = document.getElementById('sb-single-view');
            const sbComp = document.getElementById('sb-comparison-view');
            const bodyEl = document.body;

            if (match && match.redStatus === 'finish' && match.blueStatus === 'finish') {
                if(sbSingle) sbSingle.style.display = 'none';
                if(sbComp) sbComp.style.display = 'flex';
                
                bodyEl.className = '';

                // Membangun text detail pertandingan
                let kat = match.kategori || info.kategori || '';
                let gen = match.gender || match.jk || '';
                let gol = match.golongan || match.kelas || match.usia || '';
                let fullKategori = `${kat} ${gen} ${gol}`.toUpperCase().replace(/\s+/g, ' ').trim();

                const recaps = globalRekapData.filter(r => r.partai == info.partai);
                // Mengurutkan timestamp dari rekap untuk mengambil data valid terakhir (jika ada update/simpan ulang)
                recaps.sort((a,b) => (b.timestamp || 0) - (a.timestamp || 0));

                const rMerah = recaps.find(r => r.name === match.namaMerah) || {};
                const rBiru = recaps.find(r => r.name === match.namaBiru) || {};

                // Prioritaskan nilai dari DB Match (operator simpan manual) / fallback ke rekap
                let valBiru = match.blueScore !== undefined ? match.blueScore : (rBiru.final !== undefined ? rBiru.final : 0);
                let valMerah = match.redScore !== undefined ? match.redScore : (rMerah.final !== undefined ? rMerah.final : 0);
                
                let finalBiru = parseFloat(valBiru) || 0;
                let finalMerah = parseFloat(valMerah) || 0;
                let waktuB = match.waktuBiru || rBiru.waktu || '00:00.00';
                let waktuM = match.waktuMerah || rMerah.waktu || '00:00.00';
                
                let stdevB = rBiru.stdev !== undefined ? parseFloat(rBiru.stdev) : 0;
                let stdevM = rMerah.stdev !== undefined ? parseFloat(rMerah.stdev) : 0;

                // Terapkan ke elemen UI
                document.getElementById('sb-comp-partai').innerText = info.partai;
                document.getElementById('sb-comp-kategori-full').innerText = fullKategori;
                
                // SUDUT BIRU POPULATE
                document.getElementById('comp-biru-img').src = match.imgBiru || 'https://iili.io/CShnhS2.png';
                document.getElementById('comp-biru-nama').innerText = match.namaBiru || '-';
                document.getElementById('comp-biru-kont').innerText = match.kontBiru || '-';
                document.getElementById('comp-biru-final').innerText = finalBiru.toFixed(3);
                document.getElementById('comp-biru-waktu').innerText = waktuB;
                document.getElementById('comp-biru-stdev').innerText = stdevB.toFixed(6);
                
                // SUDUT MERAH POPULATE
                document.getElementById('comp-merah-img').src = match.imgMerah || 'https://iili.io/CShnhS2.png';
                document.getElementById('comp-merah-nama').innerText = match.namaMerah || '-';
                document.getElementById('comp-merah-kont').innerText = match.kontMerah || '-';
                document.getElementById('comp-merah-final').innerText = finalMerah.toFixed(3);
                document.getElementById('comp-merah-waktu').innerText = waktuM;
                document.getElementById('comp-merah-stdev').innerText = stdevM.toFixed(6);

                // PENENTUAN PEMENANG & EFEK KOTAK MENYALA (GLOW)
                let winnerName = "-";
                let winnerCont = "-";
                
                const boxBiru = document.getElementById('box-comp-biru');
                const boxMerah = document.getElementById('box-comp-merah');
                
                // Reset styling glow terlebih dahulu
                boxBiru.classList.remove('winner-glow');
                boxMerah.classList.remove('winner-glow');

                if(finalBiru > finalMerah) { 
                    winnerName = match.namaBiru; 
                    winnerCont = match.kontBiru;
                    boxBiru.classList.add('winner-glow'); // Tambah efek glow kuning keemasan untuk kotak Biru
                }
                else if(finalMerah > finalBiru) { 
                    winnerName = match.namaMerah; 
                    winnerCont = match.kontMerah;
                    boxMerah.classList.add('winner-glow'); // Tambah efek glow kuning keemasan untuk kotak Merah
                }
                else { 
                    winnerName = "DRAW / SERI"; 
                    winnerCont = "-";
                }
                
                document.getElementById('win-partai').innerText = info.partai;
                document.getElementById('win-kategori').innerText = fullKategori;
                document.getElementById('comp-winner-name').innerText = winnerName;
                document.getElementById('comp-winner-cont').innerText = winnerCont;

            } else {
                if(sbSingle) sbSingle.style.display = 'flex';
                if(sbComp) sbComp.style.display = 'none';
                
                bodyEl.className = '';
                if (info.side === 'biru') {
                    bodyEl.classList.add('theme-biru');
                } else if (info.side === 'merah') {
                    bodyEl.classList.add('theme-merah');
                }

                document.getElementById('sb-partai').innerText = info.partai;
                document.getElementById('sb-kategori').innerText = (info.kategori || '').toUpperCase();
                document.getElementById('sb-name').innerText = (info.name || '').toUpperCase();
                document.getElementById('sb-cont').innerText = (info.cont || '').toUpperCase();
                document.getElementById('sb-avatar').src = info.img || 'https://iili.io/CShnhS2.png';
            }
        }
    </script>
</body>
