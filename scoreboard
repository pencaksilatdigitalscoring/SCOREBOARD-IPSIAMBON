            <!-- 5. JUDGES -->
            <div class="judges-section" id="sb-judges-container">
                <script>
                    for(let i=1; i<=10; i++) {
                        document.write(`
                            <div class="panel judge-box offline" id="sb-card-${i}">
                                <div class="judge-label">JURI ${i}:</div>
                                <div class="judge-score" id="sbj-${i}">9.90</div>
