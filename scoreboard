<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Monitor Scoreboard TGR - Kejuaraan Pencak Silat</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    
    <!-- Firebase SDK (Compatibility Version) -->
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-database-compat.js"></script>

    <style>
        :root {
            /* Variabel default (Netral/Standar) */
            --panel-bg: rgba(15, 15, 15, 0.75); 
            --border-color: #444444;
            --shadow-color: rgba(255, 255, 255, 0.1);
            
            --border-gold: #cba052;
            --text-gold: #f6d365;
            --text-gold-light: #ffeba8;
            --text-white: #ffffff;
        }

        /* TEMA SUDUT BIRU */
        body.theme-biru {
            --panel-bg: rgba(7, 20, 45, 0.75);
            --border-color: #1f5f99;
            --shadow-color: rgba(0, 150, 255, 0.2);
        }
        body.theme-biru .theme-overlay {
            background: radial-gradient(circle at top center, rgba(10, 31, 63, 0.6) 0%, rgba(3, 10, 22, 0.9) 100%);
        }

        /* TEMA SUDUT MERAH */
        body.theme-merah {
            --panel-bg: rgba(45, 7, 7, 0.75);
            --border-color: #991f1f;
            --shadow-color: rgba(255, 50, 50, 0.2);
        }
        body.theme-merah .theme-overlay {
            background: radial-gradient(circle at top center, rgba(63, 10, 10, 0.6) 0%, rgba(22, 3, 3, 0.9) 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            color: var(--text-white);
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
        }

        /* BACKGROUND VIDEO FULLSCREEN */
        #bg-video {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            object-fit: cover;
            z-index: -2;
        }

        /* OVERLAY WARNA (NETRAL/BIRU/MERAH) */
        .theme-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            transition: all 0.5s ease;
            background: radial-gradient(circle at top center, rgba(26, 26, 46, 0.6) 0%, rgba(0, 0, 0, 0.85) 100%);
        }

        #scoreboard-section {
            width: 100%;
            height: 100%;
            padding: 1.5vh 2vw 3vh 2vw; 
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            z-index: 1;
        }

        /* BORDER STYLES */
        .panel {
            background: var(--panel-bg);
            border: 2px solid var(--border-color);
            box-shadow: 0 0 15px var(--shadow-color), inset 0 0 20px rgba(0, 0, 0, 0.5);
            border-radius: 5px;
            transition: all 0.5s ease;
            backdrop-filter: blur(3px);
        }

        .border-gold { border-color: var(--border-gold); }

        /* TEXT GRADIENTS */
        .text-gradient-gold {
            background: linear-gradient(to bottom, #fffbb3 0%, #f6c845 40%, #c18815 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0px 4px 15px rgba(246, 200, 69, 0.3);
        }

        /* 1. HEADER SECTION */
        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 12vh;
            border-bottom: 2px solid rgba(255,255,255,0.1);
            padding-bottom: 1vh;
        }
        .header-logo { height: 100px; max-height: 100%; width: auto; object-fit: contain; }
        .header-title-container { text-align: center; flex-grow: 1; display: flex; flex-direction: column; justify-content: center; }
        .header-title-top { font-size: 2.2vh; font-weight: 700; letter-spacing: 2px; }
        .header-title-main { font-size: 5vh; font-weight: 800; text-transform: uppercase; margin: -0.5vh 0; letter-spacing: 3px; }
        .header-title-sub { font-size: 2vh; font-weight: 600; letter-spacing: 4px; }

        /* 2. INFO SECTION */
        .info-section {
            display: grid;
            grid-template-columns: auto 1fr 1fr;
            gap: 2vw;
            height: 15vh;
            align-items: center;
        }
        
        .avatar-box {
            height: 100%;
            aspect-ratio: 1/1.2;
            border: 2px solid var(--border-color);
            background-color: rgba(0,0,0,0.5);
            display: flex;
            justify-content: center;
            align-items: flex-end;
            overflow: hidden;
            box-shadow: 0 0 15px var(--shadow-color);
        }
        .avatar-box img { width: 100%; height: 100%; object-fit: cover; object-position: top; }

        .info-text-box { display: flex; flex-direction: column; justify-content: center; }
        .info-label { font-size: 1.8vh; color: rgba(255,255,255,0.7); text-transform: uppercase; margin-bottom: 0.2vh;}
        .info-value { font-size: 3vh; font-weight: 700; color: var(--text-gold-light); text-transform: uppercase; margin-bottom: 0.5vh; line-height: 1.2;}
        .info-text-right { text-align: right; }

        /* 3. SCORE & TIMER SECTION */
        .main-score-section {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 2vw;
            height: 22vh;
        }
        .box-wrapper { display: flex; flex-direction: column; }
        .box-title { text-align: center; font-size: 2.2vh; font-weight: 700; color: var(--text-gold-light); margin-bottom: 0.5vh; text-transform: uppercase; letter-spacing: 1px;}
        
        .score-display {
            flex-grow: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            border-color: var(--border-gold);
            border-width: 3px;
        }
        .score-number { font-size: 15vh; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }

        .timer-display {
            flex-grow: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            border-width: 3px;
        }
        .timer-number { 
            font-family: 'Share Tech Mono', monospace; 
            font-size: 12vh; 
            color: var(--text-white); 
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.4); 
            line-height: 1;
        }

        /* 4. STATS SECTION */
        .stats-section {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr 1fr;
            gap: 1vw;
            height: 11vh;
        }
        .stat-box { display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 0.5vh; }
        .stat-label { font-size: 1.6vh; color: rgba(255,255,255,0.8); font-weight: 600; text-transform: uppercase; text-align: center; white-space: nowrap; margin-bottom: 0.5vh;}
        .stat-value { font-size: 4vh; font-weight: 700; line-height: 1;}
        
        .val-white { font-family: 'Share Tech Mono', monospace; color: var(--text-white); text-shadow: 0 0 10px rgba(255, 255, 255, 0.3); font-size: 3.5vh !important;}
        .val-gold { color: var(--text-gold-light); text-shadow: 0 0 10px rgba(246, 200, 69, 0.4); }

        /* 5. JUDGES SECTION */
        .judges-section {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            grid-template-rows: repeat(2, 1fr);
            gap: 0.8vw;
            height: 18vh;
        }
        .judge-box {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: 0.3s;
        }
        .judge-label { font-size: 1.8vh; font-weight: 600; color: #fff; margin-bottom: 0.3vh; }
        .judge-score { font-size: 4.2vh; font-weight: 800; color: var(--text-gold-light); font-variant-numeric: tabular-nums; }
        
        .judge-box.offline { opacity: 0.3; }
        .judge-box.offline .judge-score { color: #555; }

        @keyframes flashRed {
            0% { background-color: var(--panel-bg); }
            50% { background-color: rgba(231, 76, 60, 0.8); border-color: red;}
            100% { background-color: var(--panel-bg); }
        }
        .flash-pinalty { animation: flashRed 1s ease forwards; }

        /* COMPARISON SCREEN OVERRIDE */
        #sb-comparison-view {
            display: none;
            width: 100%;
            height: 100%;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .comp-container { 
            display: flex; 
            width: 100%; 
            gap: 2vw; 
            flex-grow: 1;
            margin: 2vh 0;
            min-height: 50%;
        }
        .comp-box { 
            flex: 1; 
            padding: 2.5vw; 
            border-radius: 15px; 
            display: flex; 
            flex-direction: column; 
            justify-content: center; 
            align-items: center; 
            border: 3px solid; 
            background: rgba(0,0,0,0.5); 
            backdrop-filter: blur(5px);
            transition: all 0.5s ease; /* Transisi animasi mulus */
        }
        .comp-biru { border-color: #007bff; box-shadow: inset 0 0 50px rgba(0,123,255,0.2); }
        .comp-merah { border-color: #e74c3c; box-shadow: inset 0 0 50px rgba(231,76,60,0.2); }
        
        /* EFEK MENYALA UNTUK PEMENANG */
        .winner-glow {
            border-color: #ffd700 !important;
            box-shadow: 0 0 60px rgba(255, 215, 0, 0.6), inset 0 0 30px rgba(255, 215, 0, 0.3) !important;
            transform: scale(1.03);
            z-index: 10;
        }

        .comp-score-big { font-size: 13vh; font-weight: 800; margin: 1vh 0;}
        .comp-winner { 
            text-transform: uppercase; 
            padding: 1.5vh 4vw; 
            border-radius: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(15, 15, 15, 0.85);
            margin-bottom: 2vh;
        }
        
        .result-details {
            display: flex;
            flex-direction: column;
            gap: 0.5vh;
            text-align: center;
        }
    </style>
</head>
<body>

